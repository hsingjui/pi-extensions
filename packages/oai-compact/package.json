{
  "name": "pi-oai-compact",
  "version": "0.1.0",
  "description": "A pi extension that replaces OpenAI Responses compaction with native remote compaction.",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "test:api": "node scripts/test-compact-api.ts",
    "test:prefix-cache": "node scripts/test-full-prefix-cache.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "catalog:",
    "@earendil-works/pi-ai": "catalog:",
    "@earendil-works/pi-coding-agent": "catalog:",
    "pi-custom-response-ws": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "typescript": "^5.9.3"
  },
  "pi": {
    "extensions": [
      "./extensions/pi-oai-compact.ts"
    ]
  }
}
