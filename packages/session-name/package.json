{
  "name": "pi-session-name",
  "version": "0.1.0",
  "description": "A pi extension that auto-names a session from its first user message, in the same language as the user.",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "catalog:",
    "@earendil-works/pi-ai": "catalog:",
    "@earendil-works/pi-coding-agent": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "typescript": "^5.9.3"
  },
  "pi": {
    "extensions": [
      "./extensions/pi-session-name.ts"
    ]
  }
}