{
  "name": "pi-custom-response-ws",
  "version": "0.1.0",
  "description": "OpenAI Responses WebSocket API adapter for Pi",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "scripts",
    "README.md"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "probe-ws": "node ./scripts/probe-ws.mjs",
    "probe-dialogue": "node ./scripts/probe-dialogue.mjs",
    "probe-compaction": "node ./scripts/probe-compaction.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "catalog:",
    "@earendil-works/pi-coding-agent": "catalog:",
    "undici": "^7.16.0"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "typescript": "^5.9.3"
  },
  "pi": {
    "extensions": [
      "./extensions/pi-custom-response-ws.ts"
    ]
  }
}
